# StreamHub OTT — Environment Configuration Template
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO VERSION CONTROL

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/streamhub

# Authentication & Cryptography (Required)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-long-random-text-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OTP & Email Delivery Mode
# Options: 'console' (recommended for dev & academic review) | 'smtp' | 'both'
OTP_DELIVERY_MODE=console
OTP_EXPIRE_MINUTES=10
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# Playback & Subscription Gating
REQUIRE_SUBSCRIPTION=true

# Razorpay Sandbox Credentials (Test Mode)
# From Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret
